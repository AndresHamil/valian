## Ejemplo de variables de entorno para desarrollo
# Para usar el proxy local en Vite coloca en tu máquina (NO comitear): .env.local
# VITE_API_TARGET controla a dónde Vite proxyea las rutas que empiezan con /api
# Por defecto el proyecto usa: https://node-mongodb-api-rest.vercel.app
VITE_API_TARGET=https://node-mongodb-api-rest.vercel.app

# Puedes también definir VITE_API_BASE para que la instancia axios use esa base.
# Si lo dejas vacío, axios usará rutas relativas y el proxy de Vite en desarrollo.
# VITE_API_BASE=
